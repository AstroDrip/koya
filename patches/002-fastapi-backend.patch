+from fastapi import FastAPI, HTTPException
+from pydantic import BaseModel, Field
+from .sarvam_client import generate_smoke_test_reply, SarvamNotConfigured
+
+app = FastAPI(title="MR CARE AI Receptionist Demo API", version="0.1.0", description="Local demo backend. Not connected to production CRM or telephony.")
+
+class SarvamTestRequest(BaseModel):
+    prompt: str = Field(default="Say hello in Malayalam in one short sentence.", min_length=1, max_length=2000)
+
+@app.get("/health")
+def health():
+    return {"ok": True, "service": "mrcare-demo-api", "mode": "local-demo"}
+
+@app.post("/api/test-sarvam")
+def test_sarvam(body: SarvamTestRequest):
+    try:
+        return {"ok": True, "reply": generate_smoke_test_reply(body.prompt)}
+    except SarvamNotConfigured as exc:
+        raise HTTPException(status_code=503, detail=str(exc)) from exc
+    except Exception as exc:
+        # Avoid returning provider headers, credentials, or raw SDK internals to callers.
+        raise HTTPException(status_code=502, detail="Sarvam request failed. Check server logs and Sarvam account/key status.") from exc
diff --git a/aivoice/app/sarvam_client.py b/aivoice/app/sarvam_client.py
